<div class="card mt-2" id="order-postishipping" data-postishipping-panel>
    <div class="overlay" style="display:none;"><span class="overlay_inner"><i class="material-icons postishipping-spin">sync</i></span></div>
    <div class="card-header">
        <div class="posti-header">
      <img src="{{ asset('../modules/postishipping/views/img/logo-dark.png') }}" alt="Posti logo" class="img-fluid posti-logo">
            <h3 class="card-header-title">{{ 'Posti Shipping'|trans({}, 'Modules.Postishipping.Admin') }}</h3>
        </div>
    </div>
    {% if versionUpdate is defined and versionUpdate %}
    <div class="alert alert-info m-2 mb-0">
        {{ 'A new version %version% is available. Go to [1]module settings[/1] to update.'|trans({'%version%': versionUpdate.version}, 'Modules.Postishipping.Admin')|replace({'[1]': '<a href="' ~ versionUpdate.settingsUrl ~ '">', '[/1]': '</a>'})|raw }}
    </div>
    {% endif %}
    {% include '@Modules/postishipping/views/templates/admin/order.html.twig' %}
</div>
<div class="modal fade" id="postishipping-pp-change-modal" tabindex="-1" style="display: none;" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="form-horizontal">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Edit shipping details</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">×</span>
          </button>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label class="form-control-label" for="postishipping-address-input">
                    {{ 'Address:'|trans({}, 'Modules.Postishipping.Admin') }}
                </label>
                <input type="text" value="{{ shippingAddress }}" name="posti-address" id="postishipping-address-input" aria-label="postishipping-address-input input" class="form-control mb-2 mr-sm-2">
                <button class="btn btn-primary posti-pp-change-btn">{{ 'Search'|trans({}, 'Modules.Postishipping.Admin') }}</button>
            </div>
            <div class="posti-pp-list"></div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">
            {{ 'Cancel'|trans({}, 'Modules.Postishipping.Admin') }}
          </button>
          <button type="button" class="btn btn-primary" data-postishipping-update-pp data-dismiss="modal">
            {{ 'Update'|trans({}, 'Modules.Postishipping.Admin') }}
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
{% set _jf = constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT') %}
<script type="text/javascript" data-keepinline>
    let postishipping = {
        ajaxController: {{ ajaxController|json_encode(_jf)|raw }},
        cartMeta: {{ cartMeta|json_encode(_jf)|raw }},
        metaId: {{ cartMetaId|json_encode(_jf)|raw }},
        selectedServices: {{ selectedServices|json_encode(_jf)|raw }},
        selectedServicesSpec: {{ selectedServicesSpec|json_encode(_jf)|raw }},
        selectedPickupPoint: {{ selectedPickupPoint|json_encode(_jf)|raw }},
        shippingMethod: {{ shippingMethod|json_encode(_jf)|raw }},
        order: {{ order|json_encode(_jf)|raw }},
        codData: {{ codData|json_encode(_jf)|raw }},
        dgData: {{ dgData|json_encode(_jf)|raw }},
        customSpecifiersMap: {{ customSpecifiersMap|json_encode(_jf)|raw }},
        orderTotal: {{ orderTotal|json_encode(_jf)|raw }},
        shippingAddress: {{ shippingAddress|json_encode(_jf)|raw }},
        defaultRegistration: {{ defaultRegistration|json_encode(_jf)|raw }},
        orderProducts: {{ orderProducts|json_encode(_jf)|raw }},
        postiAccess: {{ postiAccess|json_encode(_jf)|raw }},
        strings: {
          refreshBtn: "{{ 'Refresh order page'|trans({}, 'Modules.Postishipping.Admin')|e('js') }}",
          registeredWarning: "{{ 'Already registered! Registered information will be lost. Continue?'|trans({}, 'Modules.Postishipping.Admin')|e('js') }}",
          deleteWarning: "{{ 'Are you sure you want to delete this label?'|trans({}, 'Modules.Postishipping.Admin')|e('js') }}",
          deleteReturnWarning: "{{ 'Are you sure you want to delete this return label?'|trans({}, 'Modules.Postishipping.Admin')|e('js') }}",
          refresh: "{{ 'Page will be refreshed in {seconds}s... Or you can refresh manually.'|trans({}, 'Modules.Postishipping.Admin')|e('js') }}",
          additionalServicesAfterSave: "{{ 'Additional services will be available after saving'|trans({}, 'Modules.Postishipping.Admin')|e('js') }}",
          customShipping: "{{ 'Custom shipping...'|trans({}, 'Modules.Postishipping.Admin')|e('js') }}",
          originalShipping: "{{ 'Original shipping...'|trans({}, 'Modules.Postishipping.Admin')|e('js') }}",
          noAdditionalServices: "{{ 'No additional services'|trans({}, 'Modules.Postishipping.Admin')|e('js') }}",
          notSelected: "{{ 'Not selected'|trans({}, 'Modules.Postishipping.Admin')|e('js') }}",
          change: "{{ 'Change'|trans({}, 'Modules.Postishipping.Admin')|e('js') }}"
        }
    };
</script>